# Copy to android/keystore.properties (git-ignored) and fill in.
# Generate a key once:
#   keytool -genkeypair -v -keystore plantmaster-release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias plantmaster
storeFile=/absolute/path/to/plantmaster-release.jks
storePassword=CHANGE_ME
keyAlias=plantmaster
keyPassword=CHANGE_ME

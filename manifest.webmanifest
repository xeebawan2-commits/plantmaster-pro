{
  "id": "/",
  "name": "PlantMaster Pro — Plant Maintenance",
  "short_name": "PlantMaster",
  "description": "Multi-plant maintenance management: work orders, QR asset scanning, sound and vibration condition monitoring, AI troubleshooting grounded in your own equipment manuals, with Urdu and English voice input.",
  "start_url": "/?source=pwa",

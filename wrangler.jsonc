{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plantmaster-pro",
  "compatibility_date": "2026-09-18",
  // public/ is generated by scripts/build.mjs — never edit it by hand.
  // Deploy with:  npm run deploy         (app.hsbfix.org)
  //               npm run deploy:site    (hsbfix.org)
  //               npm run deploy:admin   (admin.hsbfix.org)
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
